# Flowinaja - Environment Configuration Example
# Copy this file to .env or .env.local for development.
# Do NOT commit actual secrets or credentials to version control.

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/flowinaja?schema=public"
DIRECT_URL="postgresql://postgres:your_password@localhost:5432/flowinaja?schema=public"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Secrets & Configuration (Auth.js / NextAuth v5)
# Generate a secret via: openssl rand -base64 32
AUTH_SECRET="your-32-char-random-secret-in-production"
AUTH_TRUST_HOST=true

# Google OAuth Provider
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# GitHub OAuth Provider
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"
