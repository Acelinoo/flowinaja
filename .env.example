# ==============================================================================
# FLOWINAJA — PRODUCTION & ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Salin berkas ini ke `.env` (lokal) atau konfigurasikan pada Secrets Dashboard
# platform deployment produksi Anda (misal: Vercel, Railway, Render, Docker).
# PERINGATAN: JANGAN PERNAH menyimpan kredensial atau rahasia nyata di repositori!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon / AWS RDS)
# ------------------------------------------------------------------------------
# DATABASE_URL: URL koneksi PostgreSQL utama (bisa melalui connection pooler seperti PgBouncer/Supabase Pooler).
# DIRECT_URL: URL koneksi langsung ke PostgreSQL (diperlukan Prisma untuk migrasi skema `prisma migrate`).
DATABASE_URL="postgresql://postgres:your_db_password@localhost:5432/flowinaja?schema=public"
DIRECT_URL="postgresql://postgres:your_db_password@localhost:5432/flowinaja?schema=public"

# ------------------------------------------------------------------------------
# 2. APPLICATION BASE URL
# ------------------------------------------------------------------------------
# URL publik domain tempat aplikasi berjalan.
# Pada produksi, gunakan domain HTTPS penuh (contoh: https://flowinaja.yourcompany.com).
# Pada lokal/development, gunakan http://localhost:3000.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
# AUTH_SECRET: Kunci rahasia enkripsi JWT sesi pengguna (wajib 32+ karakter acak).
# Buat string rahasia aman di terminal dengan perintah:
#   openssl rand -base64 32
AUTH_SECRET="your-32-char-random-secret-in-production"

# AUTH_TRUST_HOST: Set ke `true` jika aplikasi berada di balik reverse proxy
# (misal: Vercel, Traefik, NGINX, Cloudflare, AWS ALB, Docker).
AUTH_TRUST_HOST=true

# ------------------------------------------------------------------------------
# 4. OAUTH PROVIDERS
# ------------------------------------------------------------------------------
# Daftarkan Redirect URI pada konsol pengembang penyedia identitas:
#   - Format: ${NEXT_PUBLIC_APP_URL}/api/auth/callback/[provider]
#   - Contoh Google: https://flowinaja.yourcompany.com/api/auth/callback/google
#   - Contoh GitHub: https://flowinaja.yourcompany.com/api/auth/callback/github

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# GitHub OAuth (GitHub Developer Settings -> OAuth Apps)
AUTH_GITHUB_ID="your-github-oauth-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-client-secret"

# ------------------------------------------------------------------------------
# 5. NODE ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="production"
