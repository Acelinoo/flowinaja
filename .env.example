# Flowinaja - Environment Configuration Example
# Copy this file to .env.local for local development.
# Do NOT commit actual secrets or credentials to version control.

# Database Configuration (PostgreSQL / Supabase)
# Connect to PostgreSQL via connection pooling (e.g. Supabase Transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/flowinaja?schema=public"

# Direct connection to the database. Used for migrations and CLI commands.
DIRECT_URL="postgresql://postgres:your_password@localhost:5432/flowinaja?schema=public"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Future Auth Secret (e.g. openssl rand -base64 32)
AUTH_SECRET="change-this-to-a-secure-random-secret-in-production"
